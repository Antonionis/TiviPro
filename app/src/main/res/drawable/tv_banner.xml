<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#1C1C2A"
                android:centerColor="#11111A"
                android:startColor="#0A0A10" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Center Round Logo for Fire TV & Android TV -->
    <item
        android:drawable="@drawable/logor300"
        android:gravity="center"
        android:top="20dp"
        android:bottom="20dp"
        android:left="80dp"
        android:right="80dp" />
</layer-list>